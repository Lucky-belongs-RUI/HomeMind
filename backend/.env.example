# ============ 数据库 ============
# 默认连接本地 MySQL 8.0（smart_home 库由 database/init.sql 创建，也可使用 docker compose 启动）
MYSQL_URL=mysql+aiomysql://root:root@localhost:3306/smart_home
# ============ LLM 配置（默认 Qwen）============
LLM_PROVIDER=qwen
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# DeepSeek 切换示例
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-key
# DEEPSEEK_MODEL=deepseek-chat

# 质谱 GLM 切换示例
# LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your-key
# ZHIPU_MODEL=glm-4

# 本地 Ollama 切换示例（OpenAI 兼容接口，无需 API Key）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ============ Agent v2（LangChain + LangGraph）============
# v2 = Supervisor + 子图 + ToolNode + 反思闭环（唯一在线链路）
# legacy = 自研客户端（开场白、画像提取等直连场景）；langchain = LangChain ChatModel
LLM_ENGINE=legacy
# 路由/回复模型（留空沿用 provider 默认模型）
AGENT_ROUTER_MODEL=
AGENT_CHAT_MODEL=
# 降级模型供应商（逗号分隔），例如 deepseek,qwen
AGENT_FALLBACK_PROVIDERS=
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_MAX_REFLECTIONS=2
AGENT_MAX_CLARIFICATIONS=2
# AI 生成内容显式标识（合规）
AGENT_AI_LABEL=true

# ============ 运行环境与安全 ============
# development / production。production 下若 JWT_SECRET 仍为默认值，服务将拒绝启动
APP_ENV=development
# CORS 允许来源（逗号分隔）。生产必须改为真实前端域名，勿使用 "*"
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ============ JWT 认证 ============
# 上线前必须改为足够长的随机值（例如 openssl rand -hex 32 生成）
JWT_SECRET=smart-home-secret-key-change-in-production
JWT_EXPIRE_HOURS=24
# 个人模型 API Key 的加密密钥；留空时回退到 JWT_SECRET
MODEL_CONFIG_SECRET=

# ============ LangGraph 持久化（Postgres）============
# 与业务库 MySQL 相互独立：LangGraph 官方 checkpointer 无 MySQL 版。
# 用于持久化澄清/审批的 thread 中断态（重启可恢复）与跨线程长期记忆。
# 本地可直接 `docker compose up -d postgres` 启动。
POSTGRES_URL=postgresql://langgraph:langgraph@localhost:5432/langgraph
# 关闭后回退进程内 MemorySaver：重启丢失中断态，仅调试用
LANGGRAPH_PERSISTENCE_ENABLED=true
# 连接池上限，多副本部署时需保证 副本数 × 该值 < Postgres max_connections
LANGGRAPH_POOL_MAX_SIZE=10

# ============ 可观测性：LangSmith 追踪（默认关闭）============
# 开启后每次图执行、每个节点、每次 LLM 调用都会被记录成可回放的 trace。
# 需要同时设置 LANGSMITH_TRACING=true 与 LANGSMITH_API_KEY 才会生效。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smart-home-agent

# ============ 可选配置 ============
# CHROMA_PATH=./chroma_data
# UPLOAD_DIR=./uploads
# WHISPER_MODEL=base
# TTS_VOICE=zh-CN-XiaoxiaoNeural